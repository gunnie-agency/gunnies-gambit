# Cloudflare Workers static assets. One "*" per rule: a rule with two is silently ignored.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-%THEME_INIT_SHA256%' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://lichess.org https://api.chess.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=15552000

# HTML is always revalidated, so a deploy never leaves a browser asking for hashed files that no longer exist.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/how-to-play
  Cache-Control: no-cache

# Content-hashed by Vite: safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The engine file names carry the full Stockfish version, so a new version is a new URL: cache forever too.
/stockfish/*
  Cache-Control: public, max-age=31536000, immutable

# Pieces rarely change. Cache for a week.
/pieces/*
  Cache-Control: public, max-age=604800
