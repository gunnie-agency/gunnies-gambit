# Display name, used in index.html and the header. Change it here only.
VITE_APP_NAME="Gunnie's Gambit"
# Public URL, for the canonical link and the social preview image. No trailing slash.
VITE_SITE_URL="https://chess.gunnie.nl"
# Cloudflare Web Analytics (cookieless). Public by design: it ends up in every page. Leave empty to disable.
VITE_CF_ANALYTICS_TOKEN="9e6384bbce4548438186bd5c73a2836f"
# IndexNow key, so Bing and other IndexNow engines recrawl after each deploy. Public by design: it is served as
# /<key>.txt to prove the site is ours, and grants nothing else. Leave empty to skip the key file and the ping.
INDEXNOW_KEY="b2e14306057b13d62d5aebdd230864b1"
